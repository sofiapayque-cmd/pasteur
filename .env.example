# Copiá este archivo como .env.local (no se sube a GitHub) y completá con los
# datos de tu proyecto de Supabase: botón "Connect" en el panel del proyecto.
# En Vercel, las mismas dos variables van en Settings → Environment Variables.
#
# Son públicas a propósito (van dentro de la web). NUNCA pongas acá la
# secret key (sb_secret_…) ni la contraseña de la base de datos.
#
# Si las dejás vacías, la web funciona igual que antes, con la sala de prueba
# guardada en el navegador.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Panel del equipo del Pasteur (/equipo) ---
# Prende el panel de fichas, revisión y biblioteca. Solo en desarrollo y en
# los links de prueba de la rama ia/asistente.
# NEXT_PUBLIC_ASISTENTE=1
#
# Clave secreta de Supabase (solo servidor, sin NEXT_PUBLIC_): la usan las
# invitaciones del equipo y el alta de artículos. En Vercel, marcada Sensitive.
# SUPABASE_SECRET_KEY=
#
# Opcional: clave gratuita de OpenAlex (más consultas por día). Solo servidor.
# OPENALEX_API_KEY=
